{
  "skill_name": "fusionplace-librarian",
  "evals": [
    {
      "id": 1,
      "prompt": "Excel-Linkのインストールエラーが発生しました。エラーメッセージの画面ショットを添付しています。（「予期しないエラーが発生しました・・・ AddIn クラスの Installed プロパティを設定できません。」）",
      "expected_output": "Q&Aを参照し、アドインの有効化失敗の原因と対応策を案内。https://docs.fusionplace.net/qanda/ja/excel_link/Support_02557.html",
      "files": [],
      "assertions": [
        {
          "text": "公式ドキュメント（docs.fusionplace.net）のURLが1件以上含まれている",
          "type": "contains_pattern",
          "pattern": "docs\\.fusionplace\\.net"
        },
        {
          "text": "アドインの手動有効化に言及している",
          "type": "contains_any_keyword",
          "keywords": ["手動有効化", "手動で有効", "アドインを有効"]
        },
        {
          "text": "アドインのファイル名（fp-excel-link.xla または fp-excel-link-ribbon.xlsm）に言及している",
          "type": "contains_any_keyword",
          "keywords": ["fp-excel-link.xla", "fp-excel-link-ribbon.xlsm", "fp-excel-link"]
        },
        {
          "text": "トラストセンターまたはグループポリシーへの言及がある（セキュリティ設定による原因）",
          "type": "contains_any_keyword",
          "keywords": ["トラストセンター", "グループポリシー"]
        },
        {
          "text": "完全削除・再インストールの手順に言及している",
          "type": "contains_any_keyword",
          "keywords": ["完全削除", "再インストール", "アンインストール"]
        },
        {
          "text": "バージョン確認（Excel-Link が fusion_place に対応しているか）への言及がある",
          "type": "contains_any_keyword",
          "keywords": ["バージョン", "バージョン情報", "バージョン確認", "対応しているか"]
        },
        {
          "text": "接続先設定の確認への言及がある",
          "type": "contains_any_keyword",
          "keywords": ["接続先", "接続設定", "接続先設定"]
        },
        {
          "text": "Excel を完全に閉じた（未起動の）状態でインストールすることを推奨している",
          "type": "contains_any_keyword",
          "keywords": ["起動されていない", "未起動", "Excelを閉じ", "Excelが起動"]
        },
        {
          "text": "完全削除後に PC を再起動することを推奨している",
          "type": "contains_any_keyword",
          "keywords": ["PCを再起動", "PC を再起動", "パソコンを再起動", "再起動してから"]
        }
      ]
    },
